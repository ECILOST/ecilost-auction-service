generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  SCHEDULED
  ACTIVE
  CLOSED
  CANCELLED
}

enum AuctionableKind {
  ITEM
  LOT
}
enum RoundStatus {
  SCHEDULED
  ACTIVE
  CLOSED
}

enum BidStatus {
  ACCEPTED
  REJECTED
}

model Room {
  id String @id
  status RoomStatus @default(SCHEDULED)
  maximumCapacity Int
  admittedCount Int @default(0)
  startsAt DateTime
  scheduledBy String
  createdAt DateTime @default(now())
  rounds Round[]
  participants RoomParticipant[]
  @@index([status, startsAt])
  @@map("rooms")
}

model RoomParticipant {
  id String @id
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  admittedAt DateTime @default(now())

  // La admision es idempotente: una reconexion no debe volver a consumir aforo.
  @@unique([roomId, userId])
  @@index([userId])
  @@map("room_participants")
}

model Round {
  id              String      @id
  roomId          String
  room            Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  position        Int
  entries         RoundEntry[]
  bids            Bid[]
  status          RoundStatus @default(SCHEDULED)
  currentPrice    Decimal     @default(0) @db.Decimal(18, 2)
  currentBidderId String?
  nextBidSequence BigInt      @default(0)
  startedAt       DateTime?
  endsAt          DateTime?
  maximumEndsAt   DateTime?
  @@unique([roomId, position])
  @@index([status, endsAt])
  @@map("rounds")
}

model Bid {
  id        String    @id
  roundId   String
  round     Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  bidderId  String
  amount    Decimal   @db.Decimal(18, 2)
  sequence  BigInt
  status    BidStatus @default(ACCEPTED)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@unique([roundId, sequence])
  @@index([roundId, status, sequence])
  @@map("bids")
}

model RoundEntry {
  id String @id
  roundId String
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  kind AuctionableKind
  catalogId String
  // La base arbitra solicitudes concurrentes: una referencia solo aparece en una sala
  // no finalizada. Al cerrar/cancelar la sala, la futura HU libera esta reserva.
  @@unique([kind, catalogId])
  @@index([roundId])
  @@map("round_entries")
}
