PORT=3003
DATABASE_URL="postgresql://auction:auction@localhost:5436/ecilost_auction?schema=auction"
AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=https://auth.ecilost.local
JWT_AUDIENCE=ecilost-services
RABBITMQ_URL=amqp://ecilost:ecilost@localhost:5672

# Metricas Prometheus en GET /metrics (pruebas de rendimiento). Apagado por defecto: no tiene auth.
METRICS_ENABLED=false
